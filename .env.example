# Copy to .env (backend reads ../.env or backend/.env). Never commit .env.
ANTHROPIC_API_KEY=
MOCK_LLM=1                       # 1 = deterministic offline mode; 0 = use Claude
FAST_MODEL=claude-haiku-4-5
SMART_MODEL=claude-sonnet-4-5
DB_PATH=backend/data/fold.db
CORS_ORIGINS=http://localhost:3000
LIVE_INGEST=0                    # 1 = fetch RSS/HN on generate; 0 = seed pool only
NEXT_PUBLIC_API_URL=http://localhost:8000
