# Copy to .env (backend reads ../.env or backend/.env). Never commit .env with real secrets.
GEMINI_API_KEY=                     # Free tier at https://aistudio.google.com/
GROK_API_KEY=                       # xAI Grok key
GROQ_API_KEY=                       # GroqCloud key
ANTHROPIC_API_KEY=                  # Claude key
OPENAI_API_KEY=                     # OpenAI key

MOCK_LLM=1                          # 1 = offline mock; 0 = live LLM
FAST_MODEL=gemini-2.5-flash
SMART_MODEL=gemini-2.5-flash

DB_PATH=backend/data/fold.db
CORS_ORIGINS=http://localhost:3000
LIVE_INGEST=0                       # 1 = fetch RSS/HN on generate; 0 = seed pool only
NEXT_PUBLIC_API_URL=http://localhost:8000
